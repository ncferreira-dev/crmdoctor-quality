generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")   // Neon COM -pooler
  directUrl = env("DIRECT_URL")     // Neon SEM -pooler (migrations)
}

enum Segmento {
  FARMA
  COSMETICOS
  HOSPITALAR
  LOGISTICA
  LABORATORIO
  OUTRO
}

enum EstagioLead {
  NOVO
  CONTATO_FEITO
  QUALIFICADO
  PROPOSTA
  GANHO
  PERDIDO
}

enum EstagioProjeto {
  DIAGNOSTICO
  PROPOSTA
  EXECUCAO
  CONCLUIDO
}

enum TipoInteracao {
  LIGACAO
  EMAIL
  REUNIAO
  WHATSAPP
  VISITA
  OUTRO
}

enum StatusTicket {
  ABERTO
  EM_ANDAMENTO
  AGUARDANDO_CLIENTE
  RESOLVIDO
}

enum StatusVisita {
  AGENDADA
  CONFIRMADA
  REALIZADA
  CANCELADA
}

// Chaves fixas de permissão, validadas via class-validator (@IsIn) contra
// esta lista mantida em código (src/common/constants/permissoes.ts), não é
// enum de banco de propósito: adicionar uma permissão nova não pede migration.
//   LEADS_READ, LEADS_WRITE, EMPRESAS_READ, EMPRESAS_WRITE, PROJETOS_READ,
//   PROJETOS_WRITE, INTERACOES_READ, INTERACOES_WRITE, TICKETS_READ,
//   TICKETS_WRITE, CONSULTORES_READ, CONSULTORES_WRITE, VISITAS_READ,
//   VISITAS_WRITE, NOTIFICACOES_READ, DASHBOARD_READ, CARGOS_MANAGE,
//   USUARIOS_MANAGE
model Cargo {
  id           String   @id @default(uuid())
  nome         String   @unique
  nivel        Int      // maior número = mais graduado, mais acesso
  permissoes   String[]
  usuarios     User[]
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("cargos")
}

model User {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senhaHash String
  ativo     Boolean  @default(true)
  cargoId   String
  cargo     Cargo    @relation(fields: [cargoId], references: [id])
  criadoEm  DateTime @default(now())

  @@map("users")
}

model Lead {
  id             String          @id @default(uuid())
  nome           String
  empresaNome    String?
  email          String?
  telefone       String?
  segmento       Segmento?
  origem         String?
  estagio        EstagioLead     @default(NOVO)
  observacoes    String?
  interacoes     Interacao[]
  empresaCliente EmpresaCliente?
  criadoEm       DateTime        @default(now())
  atualizadoEm   DateTime        @updatedAt

  @@index([estagio])
  @@map("leads")
}

model EmpresaCliente {
  id           String      @id @default(uuid())
  nome         String
  cnpj         String?     @unique
  segmento     Segmento
  contatoNome  String?
  email        String?
  telefone     String?
  leadOrigemId String?     @unique
  leadOrigem   Lead?       @relation(fields: [leadOrigemId], references: [id])
  projetos     Projeto[]
  tickets      Ticket[]
  interacoes   Interacao[]
  visitas      Visita[]
  criadoEm     DateTime    @default(now())
  atualizadoEm DateTime    @updatedAt

  @@map("empresas_clientes")
}

model Projeto {
  id                   String         @id @default(uuid())
  titulo               String
  descricao            String?
  estagio              EstagioProjeto @default(DIAGNOSTICO)
  dataLimiteCompliance DateTime?      @db.Date
  valor                Decimal?       @db.Decimal(12, 2)
  empresaId            String
  empresa              EmpresaCliente @relation(fields: [empresaId], references: [id])
  interacoes           Interacao[]
  notificacoes         Notificacao[]
  criadoEm             DateTime       @default(now())
  atualizadoEm         DateTime       @updatedAt

  @@index([estagio])
  @@index([dataLimiteCompliance])
  @@map("projetos")
}

model Interacao {
  id        String          @id @default(uuid())
  tipo      TipoInteracao
  resumo    String
  data      DateTime        @default(now())
  leadId    String?
  lead      Lead?           @relation(fields: [leadId], references: [id])
  empresaId String?
  empresa   EmpresaCliente? @relation(fields: [empresaId], references: [id])
  projetoId String?
  projeto   Projeto?        @relation(fields: [projetoId], references: [id])
  criadoEm  DateTime        @default(now())

  @@map("interacoes")
}

model Ticket {
  id          String         @id @default(uuid())
  titulo      String
  descricao   String?
  status      StatusTicket   @default(ABERTO)
  prioridade  Int            @default(2) // 1 alta, 2 média, 3 baixa
  empresaId   String
  empresa     EmpresaCliente @relation(fields: [empresaId], references: [id])
  criadoEm    DateTime       @default(now())
  resolvidoEm DateTime?

  @@index([status])
  @@map("tickets")
}

model Consultor {
  id            String   @id @default(uuid())
  nome          String
  especialidade String
  ativo         Boolean  @default(true)
  visitas       Visita[]
  criadoEm      DateTime @default(now())

  @@map("consultores")
}

model Visita {
  id           String         @id @default(uuid())
  consultorId  String
  consultor    Consultor      @relation(fields: [consultorId], references: [id])
  empresaId    String
  empresa      EmpresaCliente @relation(fields: [empresaId], references: [id])
  inicio       DateTime       @db.Timestamptz(3)
  fim          DateTime       @db.Timestamptz(3)
  tipoServico  String
  status       StatusVisita   @default(AGENDADA)
  documentoUrl String?
  observacoes  String?
  criadoEm     DateTime       @default(now())
  atualizadoEm DateTime       @updatedAt

  // PREPARADO para a trava de conflito futura (não ativar agora).
  // Quando quiser, crie uma migration vazia (prisma migrate dev --create-only)
  // e cole o SQL:
  //   CREATE EXTENSION IF NOT EXISTS btree_gist;
  //   ALTER TABLE visitas ADD CONSTRAINT visitas_sem_conflito
  //     EXCLUDE USING gist (
  //       consultor_id WITH =,
  //       tstzrange(inicio, fim) WITH &&
  //     ) WHERE (status <> 'CANCELADA');
  // Por isso inicio/fim são dois timestamptz (não "data + hora em texto").
  @@index([consultorId, inicio])
  @@index([empresaId, inicio])
  @@map("visitas")
}

model Notificacao {
  id             String    @id @default(uuid())
  tipo           String    @default("COMPLIANCE_PRAZO")
  mensagem       String
  lida           Boolean   @default(false)
  projetoId      String?
  projeto        Projeto?  @relation(fields: [projetoId], references: [id])
  dataReferencia DateTime? @db.Date // = dataLimiteCompliance do projeto

  criadoEm DateTime @default(now())

  // Idempotência do cron: mesmo projeto + mesmo prazo = 1 alerta só,
  // mesmo que o job rode duas vezes no dia.
  @@unique([projetoId, tipo, dataReferencia])
  @@map("notificacoes")
}
