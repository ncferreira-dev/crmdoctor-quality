generator client {
  provider      = "prisma-client-js"
  // "native" cobre o dev local; o alvo musl-openssl-3.0 é o container Alpine
  // do EasyPanel — sem ele o engine gerado não bate com o runtime.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Neon COM -pooler
  directUrl = env("DIRECT_URL") // Neon SEM -pooler (migrations)
}

enum Segmento {
  FARMA
  COSMETICOS
  HOSPITALAR
  LOGISTICA
  LABORATORIO
  OUTRO
}

enum EstagioLead {
  NOVO
  CONTATO_FEITO
  QUALIFICADO
  PROPOSTA
  GANHO
  PERDIDO
}

enum EstagioProjeto {
  DIAGNOSTICO
  PROPOSTA
  EXECUCAO
  CONCLUIDO
}

enum TipoInteracao {
  LIGACAO
  EMAIL
  REUNIAO
  WHATSAPP
  VISITA
  OUTRO
}

enum StatusTicket {
  ABERTO
  EM_ANDAMENTO
  AGUARDANDO_CLIENTE
  RESOLVIDO
}

enum StatusVisita {
  AGENDADA
  CONFIRMADA
  REALIZADA
  CANCELADA
}

enum AcaoAudit {
  CREATE
  UPDATE
  DELETE
}

enum StatusEtapa {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
}

enum StatusTarefa {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
}

// Chaves fixas de permissão, validadas via class-validator (@IsIn) contra a
// lista mantida em código (src/common/constants/permissoes.ts). Não é enum de
// banco de propósito: adicionar uma permissão nova não pede migration.
//
// A lista NÃO é repetida aqui. Havia uma cópia manual neste comentário, e ela
// envelheceu: nasceu FINANCEIRO_READ em 05/08/2026 e a cópia continuou com 21
// nomes. Comentário que duplica dado vira mentira na primeira mudança. Para
// saber quais permissões existem, abra o arquivo citado acima.
//
// Aposentar uma permissão do código não a apaga das linhas já gravadas aqui.
// Ver cargos.service.ts: a leitura descarta o que já não é reconhecido, senão
// a sobra volta no PATCH da tela e trava todo salvamento de cargo.
model Cargo {
  id           String   @id @default(uuid())
  nome         String   @unique
  nivel        Int // maior número = mais graduado, mais acesso
  permissoes   String[]
  usuarios     User[]
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("cargos")
}

model User {
  id        String  @id @default(uuid())
  nome      String
  email     String  @unique
  telefone  String?
  senhaHash String
  ativo     Boolean @default(true)

  // Convite / primeiro acesso: o membro é cadastrado com um código de uso único
  // em vez de uma senha escolhida por terceiros. Enquanto este campo existir,
  // o login por senha é recusado: a pessoa precisa resgatar o código e definir
  // a própria senha. Ao resgatar, o campo é apagado e senhaDefinidaEm marcado.
  //
  // Guarda o HASH, nunca o código. Até 09/08/2026 a coluna se chamava
  // `codigoConvite` e guardava os 8 dígitos em claro: quem lesse a tabela, ou o
  // arquivo de backup, resgatava a conta e definia a senha. Era uma senha de
  // uso único escrita à vista, ao lado do hash da senha de verdade.
  //
  // argon2, o mesmo do senhaHash, e por isso SALGADO: não existe busca pelo
  // hash. É o motivo de o resgate pedir e-mail mais código (ver
  // UsersService.resgatarConvite). O custo é um campo a mais na tela de
  // primeiro acesso; o ganho é que nem quem tem o banco inteiro na mão
  // consegue entrar numa conta pendente.
  codigoConviteHash String?
  senhaDefinidaEm   DateTime?

  // Só preenchido para quem atua como consultor (visita cliente em campo).
  // Nulo para os demais cargos — não é um atributo de todo membro.
  especialidade String?

  cargoId           String
  cargo             Cargo                     @relation(fields: [cargoId], references: [id])
  etapasResponsavel EtapaProjeto[]
  tarefas           Tarefa[]
  visitas           Visita[]
  competencias      Competencia[]
  projetosNaEquipe  Projeto[]                 @relation("EquipeDoProjeto")
  alertas           NotificacaoDestinatario[]
  criadoEm          DateTime                  @default(now())

  @@map("users")
}

// Tarefa avulsa atribuída a um membro do time. Diferente de EtapaProjeto (que
// é marco formal de compliance, sempre preso a um projeto e alimentando o cron
// de alertas), a Tarefa é operacional: "ligar pra clínica X", "revisar o
// contrato". Pode opcionalmente pertencer a um projeto.
model Tarefa {
  id              String       @id @default(uuid())
  titulo          String
  descricao       String?
  status          StatusTarefa @default(PENDENTE)
  prazo           DateTime?    @db.Date
  responsavelId   String
  responsavel     User         @relation(fields: [responsavelId], references: [id])
  projetoId       String?
  projeto         Projeto?     @relation(fields: [projetoId], references: [id])
  concluidaEm     DateTime?
  criadoEm        DateTime     @default(now())
  atualizadoEm    DateTime     @updatedAt
  excluidoEm      DateTime?
  criadoPorId     String?
  atualizadoPorId String?

  @@index([responsavelId, status])
  @@index([prazo])
  @@map("tarefas")
}

model Lead {
  id              String          @id @default(uuid())
  nome            String
  empresaNome     String?
  email           String?
  telefone        String?
  segmento        Segmento?
  origem          String?
  estagio         EstagioLead     @default(NOVO)
  observacoes     String?
  interacoes      Interacao[]
  empresaCliente  EmpresaCliente?
  criadoEm        DateTime        @default(now())
  atualizadoEm    DateTime        @updatedAt
  excluidoEm      DateTime?
  criadoPorId     String?
  atualizadoPorId String?

  @@index([estagio])
  @@map("leads")
}

model EmpresaCliente {
  id              String      @id @default(uuid())
  nome            String
  cnpj            String?     @unique
  segmento        Segmento
  contatoNome     String?
  email           String?
  telefone        String?
  leadOrigemId    String?     @unique
  leadOrigem      Lead?       @relation(fields: [leadOrigemId], references: [id])
  projetos        Projeto[]
  tickets         Ticket[]
  interacoes      Interacao[]
  visitas         Visita[]
  criadoEm        DateTime    @default(now())
  atualizadoEm    DateTime    @updatedAt
  excluidoEm      DateTime?
  criadoPorId     String?
  atualizadoPorId String?

  @@map("empresas_clientes")
}

model Projeto {
  id                   String         @id @default(uuid())
  titulo               String
  descricao            String?
  estagio              EstagioProjeto @default(DIAGNOSTICO)
  dataLimiteCompliance DateTime?      @db.Date
  valor                Decimal?       @db.Decimal(12, 2)
  empresaId            String
  empresa              EmpresaCliente @relation(fields: [empresaId], references: [id])
  interacoes           Interacao[]
  notificacoes         Notificacao[]
  etapas               EtapaProjeto[]
  tarefas              Tarefa[]
  visitas              Visita[]

  // Quem toca este projeto. A "equipe" do sistema é isto: não existe entidade
  // Equipe solta, porque na consultoria a equipe SE define pelo projeto e muda
  // a cada contrato. Uma pessoa é o responsável; duas ou mais são a equipe.
  //
  // Relação nomeada de propósito: o Prisma nomearia a tabela de ligação a
  // partir dos dois models (_ProjetoToUser), e um nome desses não diz o que a
  // ligação significa quando alguém abrir o banco daqui a um ano.
  equipe User[] @relation("EquipeDoProjeto")

  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  excluidoEm      DateTime?
  criadoPorId     String?
  atualizadoPorId String?

  @@index([estagio])
  @@index([dataLimiteCompliance])
  @@map("projetos")
}

model Interacao {
  id              String          @id @default(uuid())
  tipo            TipoInteracao
  resumo          String
  data            DateTime        @default(now())
  leadId          String?
  lead            Lead?           @relation(fields: [leadId], references: [id])
  empresaId       String?
  empresa         EmpresaCliente? @relation(fields: [empresaId], references: [id])
  projetoId       String?
  projeto         Projeto?        @relation(fields: [projetoId], references: [id])
  criadoEm        DateTime        @default(now())
  excluidoEm      DateTime?
  criadoPorId     String?
  atualizadoPorId String?

  @@map("interacoes")
}

model Ticket {
  id                 String         @id @default(uuid())
  titulo             String
  descricao          String?
  status             StatusTicket   @default(ABERTO)
  prioridade         Int            @default(2) // 1 alta, 2 média, 3 baixa
  empresaId          String
  empresa            EmpresaCliente @relation(fields: [empresaId], references: [id])
  abertoEm           DateTime       @default(now()) // quando o cliente pediu; pode diferir de criadoEm
  primeiraRespostaEm DateTime?
  criadoEm           DateTime       @default(now())
  resolvidoEm        DateTime?
  excluidoEm         DateTime?
  criadoPorId        String?
  atualizadoPorId    String?

  @@index([status])
  @@map("tickets")
}

model Competencia {
  id              String    @id @default(uuid())
  nome            String    @unique
  descricao       String?
  usuarios        User[]
  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  excluidoEm      DateTime?
  criadoPorId     String?
  atualizadoPorId String?

  @@map("competencias")
}

model EtapaProjeto {
  id              String        @id @default(uuid())
  projetoId       String
  projeto         Projeto       @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  nome            String
  ordem           Int
  responsavelId   String?
  responsavel     User?         @relation(fields: [responsavelId], references: [id])
  prazo           DateTime?     @db.Date
  status          StatusEtapa   @default(PENDENTE)
  concluidaEm     DateTime?
  notificacoes    Notificacao[]
  criadoEm        DateTime      @default(now())
  excluidoEm      DateTime?
  criadoPorId     String?
  atualizadoPorId String?

  @@index([projetoId, ordem])
  @@index([prazo])
  @@map("etapas_projeto")
}

model Visita {
  id          String         @id @default(uuid())
  // consultorId aponta para User (cargo Consultor, ou qualquer cargo com
  // VISITAS_WRITE) — Consultor deixou de ser uma entidade separada porque o
  // consultor passou a logar no sistema.
  consultorId String
  consultor   User           @relation(fields: [consultorId], references: [id])
  empresaId   String
  empresa     EmpresaCliente @relation(fields: [empresaId], references: [id])

  // Opcional de propósito: a consultoria vende projeto de compliance e a visita
  // costuma ser execução de um marco dele, mas nem toda visita pertence a um
  // projeto (reunião comercial, diagnóstico inicial). Obrigar quebraria as
  // visitas que já existem e mentiria sobre as que nunca terão projeto.
  projetoId       String?
  projeto         Projeto?     @relation(fields: [projetoId], references: [id])
  inicio          DateTime     @db.Timestamptz(3)
  fim             DateTime     @db.Timestamptz(3)
  tipoServico     String
  status          StatusVisita @default(AGENDADA)
  documentoUrl    String?
  observacoes     String?
  criadoEm        DateTime     @default(now())
  atualizadoEm    DateTime     @updatedAt
  excluidoEm      DateTime?
  criadoPorId     String?
  atualizadoPorId String?

  // PREPARADO para a trava de conflito futura (não ativar agora).
  // Quando quiser, crie uma migration vazia (prisma migrate dev --create-only)
  // e cole o SQL:
  //   CREATE EXTENSION IF NOT EXISTS btree_gist;
  //   ALTER TABLE visitas ADD CONSTRAINT visitas_sem_conflito
  //     EXCLUDE USING gist (
  //       consultor_id WITH =,
  //       tstzrange(inicio, fim) WITH &&
  //     ) WHERE (status <> 'CANCELADA');
  // Por isso inicio/fim são dois timestamptz (não "data + hora em texto").
  @@index([consultorId, inicio])
  @@index([empresaId, inicio])
  @@index([projetoId])
  @@map("visitas")
}

// Heartbeat dos jobs agendados. Uma linha por job (upsert pela chave nome):
// registra a última execução bem-sucedida. /health/cron lê daqui e responde
// 503 quando o cron de compliance fica >26h sem rodar — é o que transforma
// "o cron morreu em silêncio" em alerta observável de fora.
model CronExecucao {
  id          String   @id @default(uuid())
  nome        String   @unique
  executadoEm DateTime
  criadoEm    DateTime @default(now())

  @@map("cron_execucoes")
}

// Uma linha por FATO, não por pessoa: "o marco X vence em tal dia" é um fato
// só, mesmo que quatro pessoas precisem saber dele. Quem precisa saber, e quem
// já leu, vivem em NotificacaoDestinatario.
//
// `mensagem` guarda o fato e nada mais. Ela NÃO pode conter contagem de dias:
// o texto é gravado uma vez e o @@unique impede regravar, então um "vence em 9
// dias" escrito aqui continua dizendo 9 pelo resto da vida. A tela calcula os
// dias a partir de dataReferencia, que é o dado, e não a frase sobre o dado.
model Notificacao {
  id       String  @id @default(uuid())
  tipo     String  @default("COMPLIANCE_PRAZO")
  mensagem String
  /// LEGADO. Era a leitura da empresa inteira: uma pessoa marcava como lida e
  /// o aviso sumia para todos. A leitura agora é por pessoa, em
  /// NotificacaoDestinatario.lidaEm. Nada escreve mais aqui. A coluna fica
  /// porque derrubá-la é migration destrutiva sobre dado existente, e o custo
  /// de mantê-la é um boolean parado.
  lida     Boolean @default(false)

  projetoId      String?
  projeto        Projeto?      @relation(fields: [projetoId], references: [id])
  etapaId        String?
  etapa          EtapaProjeto? @relation(fields: [etapaId], references: [id])
  dataReferencia DateTime?     @db.Date // = dataLimiteCompliance do projeto OU prazo da etapa

  destinatarios NotificacaoDestinatario[]

  criadoEm DateTime @default(now())

  // Idempotência do cron: mesmo projeto + mesmo prazo = 1 alerta só,
  // mesmo que o job rode duas vezes no dia.
  @@unique([projetoId, tipo, dataReferencia])
  // Idempotência do fluxo de etapas (COMPLIANCE_ETAPA): projetoId fica null
  // nessas linhas de propósito (ver notificacoes.service.ts), então a
  // deduplicação depende só deste índice, não do de cima.
  @@unique([etapaId, tipo, dataReferencia])
  @@map("notificacoes")
}

// Quem precisa saber de um aviso, e se já leu. Uma linha aqui significa duas
// coisas ao mesmo tempo: "este alerta é seu" e, quando lidaEm está preenchido,
// "você deu baixa em tal instante".
//
// Duas tabelas (uma de destinatário, outra de leitura) responderiam as mesmas
// duas perguntas com o dobro de junção e uma inconsistência possível: leitura
// de quem não é destinatário. Uma tabela só não deixa esse estado existir.
//
// Esta tabela é ADITIVA de propósito: não toca nos dois @@unique de
// notificacoes, que são o que garante a idempotência do cron. Um desenho com
// uma linha de notificação por pessoa obrigaria a derrubar e recriar aqueles
// dois índices.
model NotificacaoDestinatario {
  id            String      @id @default(uuid())
  notificacaoId String
  notificacao   Notificacao @relation(fields: [notificacaoId], references: [id], onDelete: Cascade)
  usuarioId     String
  usuario       User        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  lidaEm        DateTime?
  criadoEm      DateTime    @default(now())

  // O cron reconcilia destinatários a cada execução com skipDuplicates: este
  // índice é o que faz "acrescentar quem entrou na equipe" ser seguro de
  // repetir todo dia.
  @@unique([notificacaoId, usuarioId])
  // A pergunta que o sino faz a cada 60s: o que ESTA pessoa ainda não leu.
  @@index([usuarioId, lidaEm])
  @@map("notificacao_destinatarios")
}

model AuditLog {
  id          String    @id @default(uuid())
  entidade    String
  entidadeId  String
  acao        AcaoAudit
  usuarioId   String?
  dadosAntes  Json?
  dadosDepois Json?
  criadoEm    DateTime  @default(now())

  @@index([entidade, entidadeId])
  @@map("audit_logs")
}
