generator client {
  provider      = "prisma-client-js"
  // "native" cobre o dev local; o alvo musl-openssl-3.0 é o container Alpine
  // do EasyPanel — sem ele o engine gerado não bate com o runtime.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Neon COM -pooler
  directUrl = env("DIRECT_URL") // Neon SEM -pooler (migrations)
}

enum Segmento {
  FARMA
  COSMETICOS
  HOSPITALAR
  LOGISTICA
  LABORATORIO
  OUTRO
}

enum EstagioLead {
  NOVO
  CONTATO_FEITO
  QUALIFICADO
  PROPOSTA
  GANHO
  PERDIDO
}

enum EstagioProjeto {
  DIAGNOSTICO
  PROPOSTA
  EXECUCAO
  CONCLUIDO
}

enum TipoInteracao {
  LIGACAO
  EMAIL
  REUNIAO
  WHATSAPP
  VISITA
  OUTRO
}

enum StatusTicket {
  ABERTO
  EM_ANDAMENTO
  AGUARDANDO_CLIENTE
  RESOLVIDO
}

enum StatusVisita {
  AGENDADA
  CONFIRMADA
  REALIZADA
  CANCELADA
}

enum AcaoAudit {
  CREATE
  UPDATE
  DELETE
}

enum StatusEtapa {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
}

enum StatusTarefa {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
}

// Chaves fixas de permissão, validadas via class-validator (@IsIn) contra
// esta lista mantida em código (src/common/constants/permissoes.ts), não é
// enum de banco de propósito: adicionar uma permissão nova não pede migration.
//   LEADS_READ, LEADS_WRITE, EMPRESAS_READ, EMPRESAS_WRITE, PROJETOS_READ,
//   PROJETOS_WRITE, INTERACOES_READ, INTERACOES_WRITE, TICKETS_READ,
//   TICKETS_WRITE, CONSULTORES_READ, CONSULTORES_WRITE, VISITAS_READ,
//   VISITAS_WRITE, NOTIFICACOES_READ, DASHBOARD_READ, CARGOS_MANAGE,
//   USUARIOS_MANAGE, COMPETENCIAS_READ, COMPETENCIAS_WRITE
model Cargo {
  id           String   @id @default(uuid())
  nome         String   @unique
  nivel        Int // maior número = mais graduado, mais acesso
  permissoes   String[]
  usuarios     User[]
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("cargos")
}

model User {
  id        String  @id @default(uuid())
  nome      String
  email     String  @unique
  telefone  String?
  senhaHash String
  ativo     Boolean @default(true)

  // Convite / primeiro acesso: o membro é cadastrado com um código de uso único
  // em vez de uma senha escolhida por terceiros. Enquanto codigoConvite existir,
  // o login por senha é recusado — a pessoa precisa resgatar o código e definir
  // a própria senha. Ao resgatar, o código é apagado e senhaDefinidaEm marcado.
  codigoConvite   String?   @unique
  senhaDefinidaEm DateTime?

  cargoId           String
  cargo             Cargo          @relation(fields: [cargoId], references: [id])
  etapasResponsavel EtapaProjeto[]
  tarefas           Tarefa[]
  criadoEm          DateTime       @default(now())

  @@map("users")
}

// Tarefa avulsa atribuída a um membro do time. Diferente de EtapaProjeto (que
// é marco formal de compliance, sempre preso a um projeto e alimentando o cron
// de alertas), a Tarefa é operacional: "ligar pra clínica X", "revisar o
// contrato". Pode opcionalmente pertencer a um projeto.
model Tarefa {
  id              String       @id @default(uuid())
  titulo          String
  descricao       String?
  status          StatusTarefa @default(PENDENTE)
  prazo           DateTime?    @db.Date
  responsavelId   String
  responsavel     User         @relation(fields: [responsavelId], references: [id])
  projetoId       String?
  projeto         Projeto?     @relation(fields: [projetoId], references: [id])
  concluidaEm     DateTime?
  criadoEm        DateTime     @default(now())
  atualizadoEm    DateTime     @updatedAt
  excluidoEm      DateTime?
  criadoPorId     String?
  atualizadoPorId String?

  @@index([responsavelId, status])
  @@index([prazo])
  @@map("tarefas")
}

model Lead {
  id              String          @id @default(uuid())
  nome            String
  empresaNome     String?
  email           String?
  telefone        String?
  segmento        Segmento?
  origem          String?
  estagio         EstagioLead     @default(NOVO)
  observacoes     String?
  interacoes      Interacao[]
  empresaCliente  EmpresaCliente?
  criadoEm        DateTime        @default(now())
  atualizadoEm    DateTime        @updatedAt
  excluidoEm      DateTime?
  criadoPorId     String?
  atualizadoPorId String?

  @@index([estagio])
  @@map("leads")
}

model EmpresaCliente {
  id              String      @id @default(uuid())
  nome            String
  cnpj            String?     @unique
  segmento        Segmento
  contatoNome     String?
  email           String?
  telefone        String?
  leadOrigemId    String?     @unique
  leadOrigem      Lead?       @relation(fields: [leadOrigemId], references: [id])
  projetos        Projeto[]
  tickets         Ticket[]
  interacoes      Interacao[]
  visitas         Visita[]
  criadoEm        DateTime    @default(now())
  atualizadoEm    DateTime    @updatedAt
  excluidoEm      DateTime?
  criadoPorId     String?
  atualizadoPorId String?

  @@map("empresas_clientes")
}

model Projeto {
  id                   String         @id @default(uuid())
  titulo               String
  descricao            String?
  estagio              EstagioProjeto @default(DIAGNOSTICO)
  dataLimiteCompliance DateTime?      @db.Date
  valor                Decimal?       @db.Decimal(12, 2)
  empresaId            String
  empresa              EmpresaCliente @relation(fields: [empresaId], references: [id])
  interacoes           Interacao[]
  notificacoes         Notificacao[]
  etapas               EtapaProjeto[]
  tarefas              Tarefa[]
  criadoEm             DateTime       @default(now())
  atualizadoEm         DateTime       @updatedAt
  excluidoEm           DateTime?
  criadoPorId          String?
  atualizadoPorId      String?

  @@index([estagio])
  @@index([dataLimiteCompliance])
  @@map("projetos")
}

model Interacao {
  id              String          @id @default(uuid())
  tipo            TipoInteracao
  resumo          String
  data            DateTime        @default(now())
  leadId          String?
  lead            Lead?           @relation(fields: [leadId], references: [id])
  empresaId       String?
  empresa         EmpresaCliente? @relation(fields: [empresaId], references: [id])
  projetoId       String?
  projeto         Projeto?        @relation(fields: [projetoId], references: [id])
  criadoEm        DateTime        @default(now())
  excluidoEm      DateTime?
  criadoPorId     String?
  atualizadoPorId String?

  @@map("interacoes")
}

model Ticket {
  id                 String         @id @default(uuid())
  titulo             String
  descricao          String?
  status             StatusTicket   @default(ABERTO)
  prioridade         Int            @default(2) // 1 alta, 2 média, 3 baixa
  empresaId          String
  empresa            EmpresaCliente @relation(fields: [empresaId], references: [id])
  abertoEm           DateTime       @default(now()) // quando o cliente pediu; pode diferir de criadoEm
  primeiraRespostaEm DateTime?
  criadoEm           DateTime       @default(now())
  resolvidoEm        DateTime?
  excluidoEm         DateTime?
  criadoPorId        String?
  atualizadoPorId    String?

  @@index([status])
  @@map("tickets")
}

model Consultor {
  id              String        @id @default(uuid())
  nome            String
  especialidade   String
  ativo           Boolean       @default(true)
  visitas         Visita[]
  competencias    Competencia[]
  criadoEm        DateTime      @default(now())
  excluidoEm      DateTime?
  criadoPorId     String?
  atualizadoPorId String?

  @@map("consultores")
}

model Competencia {
  id              String      @id @default(uuid())
  nome            String      @unique
  descricao       String?
  consultores     Consultor[]
  criadoEm        DateTime    @default(now())
  atualizadoEm    DateTime    @updatedAt
  excluidoEm      DateTime?
  criadoPorId     String?
  atualizadoPorId String?

  @@map("competencias")
}

model EtapaProjeto {
  id              String        @id @default(uuid())
  projetoId       String
  projeto         Projeto       @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  nome            String
  ordem           Int
  responsavelId   String?
  responsavel     User?         @relation(fields: [responsavelId], references: [id])
  prazo           DateTime?     @db.Date
  status          StatusEtapa   @default(PENDENTE)
  concluidaEm     DateTime?
  notificacoes    Notificacao[]
  criadoEm        DateTime      @default(now())
  excluidoEm      DateTime?
  criadoPorId     String?
  atualizadoPorId String?

  @@index([projetoId, ordem])
  @@index([prazo])
  @@map("etapas_projeto")
}

model Visita {
  id              String         @id @default(uuid())
  consultorId     String
  consultor       Consultor      @relation(fields: [consultorId], references: [id])
  empresaId       String
  empresa         EmpresaCliente @relation(fields: [empresaId], references: [id])
  inicio          DateTime       @db.Timestamptz(3)
  fim             DateTime       @db.Timestamptz(3)
  tipoServico     String
  status          StatusVisita   @default(AGENDADA)
  documentoUrl    String?
  observacoes     String?
  criadoEm        DateTime       @default(now())
  atualizadoEm    DateTime       @updatedAt
  excluidoEm      DateTime?
  criadoPorId     String?
  atualizadoPorId String?

  // PREPARADO para a trava de conflito futura (não ativar agora).
  // Quando quiser, crie uma migration vazia (prisma migrate dev --create-only)
  // e cole o SQL:
  //   CREATE EXTENSION IF NOT EXISTS btree_gist;
  //   ALTER TABLE visitas ADD CONSTRAINT visitas_sem_conflito
  //     EXCLUDE USING gist (
  //       consultor_id WITH =,
  //       tstzrange(inicio, fim) WITH &&
  //     ) WHERE (status <> 'CANCELADA');
  // Por isso inicio/fim são dois timestamptz (não "data + hora em texto").
  @@index([consultorId, inicio])
  @@index([empresaId, inicio])
  @@map("visitas")
}

// Heartbeat dos jobs agendados. Uma linha por job (upsert pela chave nome):
// registra a última execução bem-sucedida. /health/cron lê daqui e responde
// 503 quando o cron de compliance fica >26h sem rodar — é o que transforma
// "o cron morreu em silêncio" em alerta observável de fora.
model CronExecucao {
  id          String   @id @default(uuid())
  nome        String   @unique
  executadoEm DateTime
  criadoEm    DateTime @default(now())

  @@map("cron_execucoes")
}

model Notificacao {
  id             String        @id @default(uuid())
  tipo           String        @default("COMPLIANCE_PRAZO")
  mensagem       String
  lida           Boolean       @default(false)
  projetoId      String?
  projeto        Projeto?      @relation(fields: [projetoId], references: [id])
  etapaId        String?
  etapa          EtapaProjeto? @relation(fields: [etapaId], references: [id])
  dataReferencia DateTime?     @db.Date // = dataLimiteCompliance do projeto OU prazo da etapa

  criadoEm DateTime @default(now())

  // Idempotência do cron: mesmo projeto + mesmo prazo = 1 alerta só,
  // mesmo que o job rode duas vezes no dia.
  @@unique([projetoId, tipo, dataReferencia])
  // Idempotência do fluxo de etapas (COMPLIANCE_ETAPA): projetoId fica null
  // nessas linhas de propósito (ver notificacoes.service.ts), então a
  // deduplicação depende só deste índice, não do de cima.
  @@unique([etapaId, tipo, dataReferencia])
  @@map("notificacoes")
}

model AuditLog {
  id          String    @id @default(uuid())
  entidade    String
  entidadeId  String
  acao        AcaoAudit
  usuarioId   String?
  dadosAntes  Json?
  dadosDepois Json?
  criadoEm    DateTime  @default(now())

  @@index([entidade, entidadeId])
  @@map("audit_logs")
}
